VITE_BINANCE_REST_BASE=https://api.binance.com
VITE_BINANCE_WS_URL=wss://stream.binance.com:9443/ws

VITE_BINANCE_FUTURES_REST_BASE=https://fapi.binance.com

# Optional free Twelve Data key for NASDAQ-100 and S&P 500 ETF price-momentum indicators.
# Get a free key at https://twelvedata.com/pricing
# Do NOT prefix with VITE_: this key stays server-side in the local Vite middleware.
TWELVEDATA_API_KEY=

# Alpaca BASIC FREE live trades + quotes: IEX exchange ONLY, not all US stock exchanges.
# Create paper or live API credentials: https://app.alpaca.markets/
# Keep these keys server-side; NEVER prefix them with VITE_ or commit .env to Git.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# IEX-only QUOTE-CLASSIFIED (estimated) BUY or SELL side turnover per 60 seconds.
# Minimum $5,000,000, matching the default Binance whale pressure threshold.
# Values under $5M are automatically rejected and enforced as $5M.
# You may raise to 10000000, 25000000, etc. Restart npm run dev after editing.
# Free IEX-only traffic may rarely reach $5M classified side volume in 60s.
ALPACA_FLOW_THRESHOLD_USD=5000000

# Read-only mobile WebSocket bridge (a separate random token).
# NEVER paste Alpaca API credentials here as the bridge token.
MOBILE_IEX_ACCESS_TOKEN=
